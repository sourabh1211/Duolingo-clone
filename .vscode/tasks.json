{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: backend (venv + deps)",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
      "windows": { "command": "python -m venv .venv; .venv\\Scripts\\pip install -r requirements-dev.txt" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: frontend (npm install)",
      "type": "shell",
      "command": "npm install",
      "windows": { "command": "npm install" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: everything",
      "dependsOn": ["Setup: backend (venv + deps)", "Setup: frontend (npm install)"],
      "problemMatcher": []
    },
    {
      "label": "Run: backend",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run: both",
      "dependsOn": ["Run: backend", "Run: frontend"],
      "problemMatcher": []
    },
    {
      "label": "Database: reset & reseed",
      "type": "shell",
      "command": ".venv/bin/python -m app.seed.seed --reset",
      "windows": { "command": ".venv\\Scripts\\python -m app.seed.seed --reset" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Test: backend (pytest)",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: e2e (Playwright)",
      "type": "shell",
      "command": "npx playwright install chromium && npx playwright test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Reference: capture original app screenshots",
      "type": "shell",
      "command": "npx playwright install chromium && npm run reference",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
