# SQLite file location (use an absolute path on a persistent disk in production)
DATABASE_URL=sqlite:///./lingo.db
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra allowed origins as a regex; covers your Vercel frontend's production and preview URLs
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Minutes it takes to regenerate one heart
HEART_REGEN_MINUTES=30
# Enables /api/dev/* endpoints (time travel for testing streaks)
ENABLE_DEV_ROUTES=true
